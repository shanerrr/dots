@define-color foreground #8a8a8d;
@define-color background rgba(30, 30, 30, 1);

* {
  background-color: @background;
  color: @foreground;
  border: none;
  border-radius: 0;
  min-height: 0;
  font-family: CaskaydiaMono Nerd Font;
  font-size: 14px;
}

.modules-left {
  margin-left: 8px;
}

.modules-right {
  margin-right: 8px;
}

#workspaces button {
  all: initial;
  padding: 0 6px;
  margin: 0 1.5px;
  min-width: 9px;
}

#workspaces button.empty {
  opacity: 0.5;
}

#cpu,
#network,
#pulseaudio {
  min-width: 14px;
  margin: 0 7.5px;
}

tooltip {
  padding: 2px;
}

#clock {
  padding-left: 16px;
  font-family: JetBrains Mono;
  font-weight: 600;
}

.hidden {
  opacity: 0;
}


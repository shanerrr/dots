[
  {
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 5,
    "modules-left": [
      "niri/workspaces"
    ],
    "modules-right": [
      // "cpu",
      // "memory",
      "pulseaudio",
      "clock"
    ],
    "niri/workspaces": {
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "default": "",
        "active": ""
      }
    },
    "clock": {
      "format": "{:%A %B %d %H:%M}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
      "format": "  {usage}%"
    },
    "memory": {
      "format": "  {}%"
    },
    "pulseaudio": {
      "scroll-step": 5,
      "format": "{icon}",
      "format-icons": {
        "default": [
          "",
          "",
          ""
        ]
      },
      "on-click": "kitty --class=Wiremix -e wiremix"
    }
  }
]
